{
    "install_with_latest_terraform": {
        "image": "mcr.microsoft.com/devcontainers/base:debian",
        "features": {
            "tfenv": {
                "version": "latest",
                "with": "latest"
            }
        }
    },
    "install_without_terraform": {
        "image": "mcr.microsoft.com/devcontainers/base:debian",
        "features": {
            "tfenv": {
                "version": "master",
                "with": "none"
            }
        }
    }
}